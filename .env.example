# ========================================================
# EmployeeHub - Environment Variables Configuration
# ========================================================

# --- BACKEND SETTINGS ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- POSTGRESQL DATABASE CONFIGURATION ---
# Option 1: Full PostgreSQL connection URI
# DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/employeehub

# Option 2: Individual connection variables
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_password
PGDATABASE=employeehub
DB_SSL=false

# Fallback mode: When true, automatically activates in-memory store
# if PostgreSQL database is not reachable.
USE_MOCK_FALLBACK=true

# --- FRONTEND SETTINGS (Optional in dev, defaults to /api proxy) ---
# VITE_API_URL=http://localhost:5000/api
